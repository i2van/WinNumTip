/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_TRAYMENU MENU
BEGIN
    POPUP "TrayContext"
    BEGIN
        MENUITEM "&Preferences...",             IDM_PREFERENCES
        MENUITEM "&About",                      IDM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOGEX 0, 0, 232, 97
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WinNumTip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APPICON,IDC_STATIC,7,7,20,20
    LTEXT           "WinNumTip %s",IDC_ABOUT_NAME,36,7,189,10
    CONTROL         "Shows the <a href=""https://support.microsoft.com/en-us/windows/keyboard-shortcuts-in-windows-dcc61a57-8ff0-cffe-9796-cb9706c75eec#taskbar"">Win+number (0..9) shortcut</a> for each app pinned to the taskbar.",IDC_ABOUT_DESC,
                    "SysLink",WS_TABSTOP,36,20,189,18
    CONTROL         "<a href=""https://github.com/i2van/WinNumTip/blob/main/README.md"">README</a>   <a href=""https://github.com/i2van/WinNumTip/"">Project site</a>",IDC_ABOUT_LINK,
                    "SysLink",WS_TABSTOP,36,43,189,10
    LTEXT           "Copyright © %s Ivan Ivon",IDC_ABOUT_COPYRIGHT,36,63,189,10
    CONTROL         "<a>Preferences</a>",IDC_ABOUT_PREFS,"SysLink",WS_TABSTOP,36,79,60,10
    DEFPUSHBUTTON   "OK",IDOK,175,76,50,14
END

IDD_PREFERENCES DIALOGEX 0, 0, 232, 126
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WinNumTip Preferences"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Label &size:",IDC_SIZE_LABEL,7,9,32,10
    LTEXT           "Default",IDC_SIZE_VALUE,39,9,40,10
    CONTROL         "",IDC_SIZE_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,7,23,218,26
    LTEXT           "Default",IDC_STATIC,7,50,80,9
    RTEXT           "Taskbar button",IDC_STATIC,135,50,90,9
    CONTROL         "&Invert colors",IDC_INVERT,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,68,150,10
    CONTROL         "&Bold font",IDC_BOLD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,82,150,10
    CONTROL         "<a>Reset to defaults</a>",IDC_RESET,"SysLink",WS_GROUP | WS_TABSTOP,7,108,100,10
    DEFPUSHBUTTON   "OK",IDOK,121,105,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,175,105,50,14
END



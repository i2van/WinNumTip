IDD_ABOUT DIALOGEX 0, 0, 232, 97
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_CONTEXTHELP | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WinNumTip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APPICON,IDC_STATIC,7,7,20,20
    LTEXT           "WinNumTip %s",IDC_ABOUT_NAME,36,7,189,10
    CONTROL         "Shows the <a href=""https://support.microsoft.com/en-us/windows/keyboard-shortcuts-in-windows-dcc61a57-8ff0-cffe-9796-cb9706c75eec#taskbar"">Win+number (0..9) shortcut</a> for each app pinned to the taskbar.",IDC_ABOUT_DESC,
                    "SysLink",WS_GROUP | WS_TABSTOP,36,20,189,18
    CONTROL         "<a href=""https://github.com/i2van/WinNumTip/blob/main/README.md"">README</a>",IDC_ABOUT_README,
                    "SysLink",WS_GROUP | WS_TABSTOP,36,43,30,10
    CONTROL         "<a href=""https://github.com/i2van/WinNumTip/"">Project site</a>",IDC_ABOUT_PROJECT_SITE,
                    "SysLink",WS_TABSTOP,70,43,51,10
    LTEXT           "Copyright \xA9 2026 Ivan Ivon",IDC_ABOUT_COPYRIGHT,36,63,189,10
    CONTROL         "<a>Preferences</a>",IDC_ABOUT_PREFS,"SysLink",WS_GROUP | WS_TABSTOP,36,79,60,10
    DEFPUSHBUTTON   "OK",IDOK,175,76,50,14,WS_GROUP
END

IDD_PREFERENCES DIALOGEX 0, 0, 270, 207
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_CONTEXTHELP | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WinNumTip Preferences"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Tip &size:",IDC_SIZE_LABEL,7,8,110,10
    RTEXT           "%d%%",IDC_SIZE_VALUE,193,8,70,10
    CONTROL         "",IDC_SIZE_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,7,21,256,26
    LTEXT           "Default",IDC_STATIC,7,48,80,9
    RTEXT           "Taskbar button",IDC_STATIC,173,48,90,9
    LTEXT           "Tip &font:",IDC_FONT_LABEL,7,67,27,8
    PUSHBUTTON      "Select...",IDC_FONT_BUTTON,213,64,50,14
    LTEXT           "Default",IDC_FONT_NAME,37,64,172,15,SS_NOPREFIX | SS_CENTERIMAGE | SS_ENDELLIPSIS | WS_BORDER
    CONTROL         "In&vert colors",IDC_INVERT,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,86,253,10
    LTEXT           "Tips &refresh:",IDC_REFRESH_LABEL,7,104,110,10
    RTEXT           "%d ms",IDC_REFRESH_VALUE,193,104,70,10
    CONTROL         "",IDC_REFRESH_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,7,117,256,26
    LTEXT           "&Win key poll:",IDC_POLL_LABEL,7,146,110,10
    RTEXT           "%d ms",IDC_POLL_VALUE,193,146,70,10
    CONTROL         "",IDC_POLL_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,7,159,256,26
    CONTROL         "<a>Reset to defaults</a>",IDC_RESET,"SysLink",WS_GROUP | WS_TABSTOP,7,191,91,10
    DEFPUSHBUTTON   "OK",IDOK,105,187,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,159,187,50,14
    PUSHBUTTON      "&Apply",IDC_APPLY,213,187,50,14,WS_DISABLED
END

FONTSELECTORDLG DIALOGEX 11, 47, 258, 267
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU

    COMBOBOX        1136,6,16,137,229,CBS_SIMPLE | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_SORT | CBS_HASSTRINGS | CBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "<A>Reset to default</A>",IDC_FONT_RESET_LINK,"SysLink",LWS_RIGHT | WS_GROUP | WS_TABSTOP,72,6,71,9
    LTEXT           "Font st&yle:",1089,150,6,101,8
    COMBOBOX        1137,150,16,101,146,CBS_SIMPLE | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_HASSTRINGS | CBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Effects",1072,150,166,101,38,WS_GROUP
    CONTROL         "Stri&keout",1040,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,155,178,86,9
    CONTROL         "&Underline",1041,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,155,189,86,9
    GROUPBOX        "Sample",1073,150,208,101,35,WS_GROUP
    CTEXT           "",1092,151,216,100,23,SS_NOPREFIX | SS_CENTERIMAGE
    DEFPUSHBUTTON   "OK",IDOK,93,248,51,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,147,248,51,14
    PUSHBUTTON      "&Apply",1026,201,248,51,14,WS_DISABLED
    PUSHBUTTON      "&Help",1038,104,307,47,12,NOT WS_VISIBLE
    CONTROL         "<A>Show more fonts</A>",1592,"SysLink",WS_GROUP | WS_TABSTOP,6,251,83,9
    LTEXT           "&Size:",1090,6,265,26,8,NOT WS_VISIBLE
    COMBOBOX        1138,34,265,31,52,CBS_SIMPLE | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_SORT | CBS_HASSTRINGS | CBS_DISABLENOSCROLL | NOT WS_VISIBLE | WS_VSCROLL
    LTEXT           "&Color:",1091,69,265,26,8,NOT WS_VISIBLE
    COMBOBOX        1139,97,265,70,87,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_HASSTRINGS | NOT WS_VISIBLE | WS_BORDER | WS_VSCROLL
    LTEXT           "Sc&ript:",1094,6,279,26,8,NOT WS_VISIBLE
    COMBOBOX        1140,34,279,70,26,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_HASSTRINGS | NOT WS_VISIBLE | WS_BORDER | WS_VSCROLL
    LTEXT           "",1093,6,293,197,8,SS_NOPREFIX | NOT WS_VISIBLE
END



// WinNumTip.rc2 - version-information resource (kept out of the main .rc so the
// Visual Studio resource editor never rewrites it).
//
// The version numbers and current year are supplied by the build as RC preprocessor
// defines (see the <ResourceCompile> block in WinNumTip.vcxproj), sourced from the
// root Directory.Build.props ($(Version), $(DisplayVersion), $(CurrentYear)). The
// copyright start year is authored here; the displayed years become "start-current"
// once the current year differs. The #ifndef fallbacks let the file still compile
// without build-supplied defines.

// The version/style symbols (VS_VERSION_INFO, VS_FF_DEBUG, VFT_APP, ...) come from
// winres.h, which the including WinNumTip.rc pulls in ahead of this file (this .rc2 is
// only ever #included from there, never compiled on its own).

#ifndef APP_VER_COMMA
#define APP_VER_COMMA 0,0,0,0          // FILEVERSION/PRODUCTVERSION (comma form)
#endif
#ifndef APP_VER_STR
#define APP_VER_STR   0.0              // FileVersion string (DisplayVersion)
#endif
#ifndef APP_PROD_STR
#define APP_PROD_STR  0.0.0.0          // ProductVersion string (full Version)
#endif

#define APP_COPYRIGHT_START_YEAR 2026
#ifndef APP_YEAR
#define APP_YEAR APP_COPYRIGHT_START_YEAR
#endif

#define APP_STRINGIZE2(x) #x
#define APP_STRINGIZE(x)  APP_STRINGIZE2(x)

#if APP_COPYRIGHT_START_YEAR == APP_YEAR
#define APP_COPYRIGHT_YEARS APP_STRINGIZE(APP_YEAR)
#else
#define APP_COPYRIGHT_YEARS APP_STRINGIZE(APP_COPYRIGHT_START_YEAR) "-" APP_STRINGIZE(APP_YEAR)
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VER_COMMA
 PRODUCTVERSION APP_VER_COMMA
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004B0"   // Language-neutral, Unicode
        BEGIN
            VALUE "CompanyName",      "Ivan Ivon (ivan.ivon@gmail.com)"
            VALUE "FileDescription",  "Shows the Win+number (0..9) shortcut for each app pinned to the taskbar"
            VALUE "FileVersion",      APP_STRINGIZE(APP_VER_STR)
            VALUE "InternalName",     "WinNumTip"
            VALUE "OriginalFilename", "WinNumTip.exe"
            VALUE "ProductName",      "WinNumTip"
            VALUE "ProductVersion",   APP_STRINGIZE(APP_PROD_STR)
            VALUE "LegalCopyright",   "Copyright \xA9 " APP_COPYRIGHT_YEARS " Ivan Ivon"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 1200   // Language-neutral, Unicode (CP 1200)
    END
END

  <UsingTask TaskName="UpdateWinNumTipResource"
             TaskFactory="CodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ResourcePath ParameterType="System.String" Required="true" />
      <VersionResourcePath ParameterType="System.String" Required="true" />
      <CurrentYear ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string versionText = File.ReadAllText(VersionResourcePath);
        Regex startYearPattern = new Regex(
            @"^[ \t]*#define[ \t]+APP_COPYRIGHT_START_YEAR[ \t]+(?<year>[0-9]{4})[ \t]*\r?$",
            RegexOptions.Multiline);
        Match startYearMatch = startYearPattern.Match(versionText);
        if (!startYearMatch.Success || startYearMatch.NextMatch().Success)
        {
            Log.LogError(
                "Expected exactly one APP_COPYRIGHT_START_YEAR definition in '{0}'.",
                VersionResourcePath);
            return false;
        }

        int startYear;
        int currentYear;
        if (!Int32.TryParse(startYearMatch.Groups["year"].Value, out startYear) ||
            !Int32.TryParse(CurrentYear, out currentYear) ||
            currentYear < startYear)
        {
            Log.LogError(
                "Invalid copyright year range: start year '{0}', current year '{1}'.",
                startYearMatch.Groups["year"].Value,
                CurrentYear);
            return false;
        }

        Regex versionPattern = new Regex(
            @"^[ \t]*VALUE[ \t]+""LegalCopyright""[ \t]*,[ \t]*""(?<prefix>[^""\r\n]*)""[ \t]+APP_COPYRIGHT_YEARS[ \t]+""(?<suffix>[^""\r\n]*)""[ \t]*\r?$",
            RegexOptions.Multiline);
        Match versionMatch = versionPattern.Match(versionText);
        if (!versionMatch.Success || versionMatch.NextMatch().Success)
        {
            Log.LogError(
                "Expected one LegalCopyright VALUE using APP_COPYRIGHT_YEARS in '{0}'.",
                VersionResourcePath);
            return false;
        }

        string years =
            startYear == currentYear
                ? currentYear.ToString()
                : startYear.ToString() + "-" + currentYear.ToString();
        string copyright =
            "\"" +
            versionMatch.Groups["prefix"].Value +
            years +
            versionMatch.Groups["suffix"].Value +
            "\"";

        string resourceText = File.ReadAllText(ResourcePath);
        Regex labelPattern = new Regex(
            @"^(?<prefix>[ \t]*LTEXT[ \t]+)""[^""\r\n]*""(?<suffix>[ \t]*,IDC_ABOUT_COPYRIGHT[ \t]*,.*)$",
            RegexOptions.Multiline);
        Match labelMatch = labelPattern.Match(resourceText);
        if (!labelMatch.Success || labelMatch.NextMatch().Success)
        {
            Log.LogError(
                "Expected exactly one IDC_ABOUT_COPYRIGHT LTEXT in '{0}'.",
                ResourcePath);
            return false;
        }

        string label =
            labelMatch.Groups["prefix"].Value +
            copyright +
            labelMatch.Groups["suffix"].Value;
        string updatedText =
            resourceText.Substring(0, labelMatch.Index) +
            label +
            resourceText.Substring(labelMatch.Index + labelMatch.Length);

        if (!String.Equals(resourceText, updatedText, StringComparison.Ordinal))
        {
            File.WriteAllText(ResourcePath, updatedText, new UTF8Encoding(false));
        }

        return true;
      ]]></Code>
    </Task>
  </UsingTask>


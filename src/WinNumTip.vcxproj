  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <!-- Non-incremental link in Release so the deterministic /Brepro output is stable. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <!-- Common settings: no CRT, size-optimized, custom entry point. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Optimize for size. -->
      <Optimization>MinSpace</Optimization>
      <FavorSizeOrSpeed>Size</FavorSizeOrSpeed>
      <IntrinsicFunctions>false</IntrinsicFunctions>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <!-- The About dialog fills its "%s" version/year placeholders at runtime from
           these (same numbers as the version resource; see res\WinNumTip.rc2). -->
      <PreprocessorDefinitions>APP_VER_STR=$(DisplayVersion);APP_YEAR=$(CurrentYear);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- No CRT: skip the stack-checking helper (__chkstk lives in the CRT). -->
      <AdditionalOptions>/Gs9999999 %(AdditionalOptions)</AdditionalOptions>
      <!-- Precompiled header. -->
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>stdafx.h</PrecompiledHeaderFile>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <IgnoreAllDefaultLibraries>true</IgnoreAllDefaultLibraries>
      <EntryPointSymbol>Entry</EntryPointSymbol>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>kernel32.lib;user32.lib;gdi32.lib;ole32.lib;oleaut32.lib;shell32.lib;uxtheme.lib;comctl32.lib;comdlg32.lib;version.lib</AdditionalDependencies>
    </Link>
    <Manifest>
      <!-- Embeds WinNumTip.manifest (Common-Controls v6 for visual styles +
           Per-Monitor-V2 DPI) via the toolchain's manifest tool. -->
      <AdditionalManifestFiles>res\WinNumTip.manifest</AdditionalManifestFiles>
    </Manifest>
    <ResourceCompile>
      <Culture>0x0000</Culture>   <!-- Language-neutral (invariant) resources -->
      <!-- Version info (res\WinNumTip.rc2) is stamped from Directory.Build.props:
           $(Version) drives the numeric + product strings, $(DisplayVersion) the
           file-version string, $(CurrentYear) the copyright year. -->
      <PreprocessorDefinitions>APP_VER_COMMA=$(Version.Replace('.',','));APP_VER_STR=$(DisplayVersion);APP_PROD_STR=$(Version);APP_YEAR=$(CurrentYear);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <!-- Debug: no optimization (overrides the size-optimized common settings) for
           accurate stepping/inspection. No-CRT flags stay inherited from the common
           group (/Gs9999999, BufferSecurityCheck off). -->
      <Optimization>Disabled</Optimization>
      <FavorSizeOrSpeed>Neither</FavorSizeOrSpeed>
      <PreprocessorDefinitions>_DEBUG;DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <!-- Make the rc2's VS_FF_DEBUG file flag actually apply in Debug builds. -->
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Deterministic (reproducible) codegen: identical sources -> identical bits. -->
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <!-- Deterministic link: reproducible PE timestamp + debug GUID (no wall clock). -->
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

